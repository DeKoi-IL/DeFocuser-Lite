<Window x:Class="ASCOM.DeKoi.DeFocuserApp.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="640" Height="760"
        MinWidth="560" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize" ShowInTaskbar="False"
        FontFamily="{StaticResource SansFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6" />
  </WindowChrome.WindowChrome>

  <Border Background="{StaticResource WindowBackgroundBrush}"
          CornerRadius="14"
          BorderBrush="{StaticResource LineBrush}"
          BorderThickness="1"
          Margin="12"
          Effect="{StaticResource WindowShadow}"
          SnapsToDevicePixels="True"
          ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Grid.Row="0"
              Background="{StaticResource TitleBarBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,0,0,1"
              Padding="14,10"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="{StaticResource Icon.Cog}" Style="{StaticResource HeaderIconPath}" />
            <TextBlock Text="Settings"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>

          <Button Grid.Column="1" Style="{StaticResource WindowCloseButton}"
                  Click="CloseButton_Click" ToolTip="Close">
            <Path Data="{StaticResource Icon.X}" Style="{StaticResource WinIconPath}" Width="11" Height="11" />
          </Button>
        </Grid>
      </Border>

      <!-- Body -->
      <ScrollViewer Grid.Row="1" Padding="18,18,18,0"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel>

          <!-- Updates section -->
          <Border Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="10"
                  Padding="14" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Path Data="{StaticResource Icon.Refresh}" Style="{StaticResource HeaderIconPath}" />
                <TextBlock Text="UPDATES" Style="{StaticResource CardLabel}" Margin="9,0,0,0" />
              </StackPanel>

              <!-- Hub row -->
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" MinWidth="120" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hub app" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock Text="Installed " Foreground="{StaticResource Text3Brush}" />
                  <TextBlock Text="{Binding HubVersionDisplay}" Foreground="{StaticResource TextBrush}"
                             FontFamily="{StaticResource MonoFont}" />
                  <TextBlock Text=" · Latest " Foreground="{StaticResource Text3Brush}" />
                  <TextBlock Text="{Binding LatestHubVersionDisplay}" Foreground="{StaticResource TextBrush}"
                             FontFamily="{StaticResource MonoFont}" />
                </WrapPanel>
                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                        Content="Install update"
                        Command="{Binding InstallUpdateCommand}"
                        Visibility="{Binding HubUpdateAvailable, Converter={StaticResource BoolToVis}}" />
              </Grid>

              <!-- Firmware row -->
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" MinWidth="120" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Firmware" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                  <TextBlock Text="Device " Foreground="{StaticResource Text3Brush}" />
                  <TextBlock Text="{Binding FirmwareVersionDisplay}" Foreground="{StaticResource TextBrush}"
                             FontFamily="{StaticResource MonoFont}" />
                  <TextBlock Text=" · Latest " Foreground="{StaticResource Text3Brush}" />
                  <TextBlock Text="{Binding LatestFirmwareVersionDisplay}" Foreground="{StaticResource TextBrush}"
                             FontFamily="{StaticResource MonoFont}" />
                </WrapPanel>
                <Button Grid.Column="2" Style="{StaticResource SmButton}"
                        Content="Update firmware"
                        Command="{Binding FlashFirmwareCommand}"
                        Visibility="{Binding FirmwareUpdateAvailable, Converter={StaticResource BoolToVis}}" />
              </Grid>

              <!-- Board / MCU. Picks which firmware variant gets downloaded
                   and which esptool chip argument is used. -->
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Board" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding BoardOptions}"
                          SelectedItem="{Binding SelectedBoard, Mode=TwoWay}"
                          ToolTip="Which MCU/board revision this focuser uses. Firmware is published per board." />
              </Grid>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" />
                <WrapPanel Grid.Column="1">
                  <TextBlock Text="Device reports " Foreground="{StaticResource Text3Brush}" FontSize="11.5" />
                  <TextBlock Text="{Binding DeviceBoardDisplay}" Foreground="{StaticResource Text2Brush}"
                             FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                </WrapPanel>
              </Grid>

              <!-- Mismatch is exactly the 2.3.0 failure: right firmware version,
                   wrong pinout. Block the flash until the selection is fixed. -->
              <Border Background="#33FFB020" BorderBrush="{StaticResource WarnBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                      Visibility="{Binding BoardMismatch, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="11.5"
                           Text="The connected device reports a different board than the one selected. Flashing is disabled — pick the board the device reports, or reconnect the focuser you meant to update." />
              </Border>

              <Border Height="1" Background="{StaticResource LineBrush}" Margin="-14,4,-14,12" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Status}" Foreground="{StaticResource Text2Brush}" />
                  <TextBlock Text="{Binding LastCheckedDisplay}" Foreground="{StaticResource Text3Brush}"
                             FontSize="11.5" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SmButton}"
                        Content="Check for updates"
                        Command="{Binding CheckForUpdatesCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Stall detection section -->
          <Border Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource LineBrush}"
                  BorderThickness="1" CornerRadius="10"
                  Padding="14" Margin="0,0,0,14">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Path Data="{StaticResource Icon.Sliders}" Style="{StaticResource HeaderIconPath}" />
                <TextBlock Text="STALL DETECTION" Style="{StaticResource CardLabel}" Margin="9,0,0,0" />
              </StackPanel>
              <TextBlock Text="Tune how the firmware decides a real stall has occurred. Stalls below the threshold are ignored; counted stalls within the window trigger an actual stall. Connect the device to edit."
                         Style="{StaticResource MutedText}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12" />

              <!-- Enabled -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Detection enabled" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1"
                          Content="Halt motor on detected stalls"
                          IsChecked="{Binding StallEnabled, Mode=TwoWay}"
                          IsEnabled="{Binding IsConnected}"
                          VerticalAlignment="Center" />
              </Grid>

              <!-- Threshold -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                  <TextBlock Text="Sensitivity" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="TMC SGTHRS register"
                             Foreground="{StaticResource Text3Brush}" FontSize="10.5"
                             Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <Slider Style="{StaticResource ThemedSlider}"
                          Minimum="{Binding StallThresholdMin, Mode=OneWay}"
                          Maximum="{Binding StallThresholdMax, Mode=OneWay}"
                          Value="{Binding StallThreshold, Mode=TwoWay}"
                          SmallChange="1" LargeChange="8"
                          IsEnabled="{Binding IsConnected}" />
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Most sensitive"
                               Foreground="{StaticResource Text3Brush}" FontSize="10.5"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StallThreshold}"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource Text2Brush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Least sensitive"
                               Foreground="{StaticResource Text3Brush}" FontSize="10.5"
                               HorizontalAlignment="Right" />
                  </Grid>
                </StackPanel>
              </Grid>

              <!-- Stall count -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                  <TextBlock Text="Stall count" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="Hits needed in window"
                             Foreground="{StaticResource Text3Brush}" FontSize="10.5"
                             Margin="0,2,0,0" />
                </StackPanel>
                <Grid Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding StallCount, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           IsEnabled="{Binding IsConnected}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                             VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="hits ("/><Run Text="{Binding StallCountMin, Mode=OneWay}"/><Run Text="–"/><Run Text="{Binding StallCountMax, Mode=OneWay}"/><Run Text=")"/>
                  </TextBlock>
                </Grid>
              </Grid>

              <!-- Stall time window -->
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                  <TextBlock Text="Time window" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="Span for cumulative hits"
                             Foreground="{StaticResource Text3Brush}" FontSize="10.5"
                             Margin="0,2,0,0" />
                </StackPanel>
                <Grid Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding StallWindow, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           IsEnabled="{Binding IsConnected}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                             VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="ms ("/><Run Text="{Binding StallWindowMin, Mode=OneWay}"/><Run Text="–"/><Run Text="{Binding StallWindowMax, Mode=OneWay}"/><Run Text=")"/>
                  </TextBlock>
                </Grid>
              </Grid>

              <!-- Grace period -->
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Top" Margin="0,2,0,0">
                  <TextBlock Text="Grace period" Style="{StaticResource FieldLabel}" />
                  <TextBlock Text="Ignore stalls after move start"
                             Foreground="{StaticResource Text3Brush}" FontSize="10.5"
                             Margin="0,2,0,0" />
                </StackPanel>
                <Grid Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding StallGrace, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                           IsEnabled="{Binding IsConnected}" />
                  <TextBlock Grid.Column="1" Style="{StaticResource MutedText}"
                             VerticalAlignment="Center" Margin="8,0,0,0">
                    <Run Text="ms ("/><Run Text="{Binding StallGraceMin, Mode=OneWay}"/><Run Text="–"/><Run Text="{Binding StallGraceMax, Mode=OneWay}"/><Run Text=")"/>
                  </TextBlock>
                </Grid>
              </Grid>

              <Border Height="1" Background="{StaticResource LineBrush}" Margin="-14,12,-14,12" />

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource SmButton}"
                        Content="Reset to defaults"
                        Command="{Binding ResetStallDefaultsCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <Border Grid.Row="2"
              Background="{StaticResource TitleBarBrush}"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,1,0,0"
              Padding="14,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource SmButton}" Content="Close" Click="CloseButton_Click" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
